{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Doc Generation",
      "type": "Ruby",
      "request": "launch",
      "cwd": "${workspaceRoot}",
      "program": "${workspaceRoot}/bin/rake",
      "args": [
        "generate_cops_documentation"
      ]
    },
    {
      "type": "rdbg",
      "name": "Debug RSpec - All Tests",
      "request": "launch",
      "command": "bundle exec rspec",
      "script": "",
      "args": [],
      "askParameters": false
    },
    {
      "type": "rdbg",
      "name": "Debug RSpec - Current File",
      "request": "launch",
      "command": "bundle exec rspec",
      "script": "${file}",
      "args": [],
      "askParameters": false
    },
    {
      "type": "rdbg",
      "name": "Debug RSpec - Current Test",
      "request": "launch",
      "command": "bundle exec rspec",
      "script": "${file}:${lineNumber}",
      "args": [],
      "askParameters": false
    }
  ]
}
