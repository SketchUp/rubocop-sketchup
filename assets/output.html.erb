<!DOCTYPE html>
<html>
  <head>
    <meta charset='UTF-8' />
    <title>SketchUp Extension RuboCop Inspection Report</title>
    <%# TODO: Clean up the messy markup and style definitions. %>
    <link href="https://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet">
    <style>
    :root {
    color-scheme: light;
    --primary: #0063a3;
    --primary-content: #ffffff;
    --secondary: #fbad26;
    --secondary-content: #000000;
    --secondary-pale: #fff5e4;
    --accent: #6a6e79;
    --accent-content: #ffffff;
    --neutral: #ffffff;
    --neutral-content: #171c1e;
    --surface: #f5f5f8;
    --surface-subtle: #f5f5f8;
    --muted: #6a6e79;
    --border: rgba(106, 110, 121, 0.3);
    --code-background: #f5f5f8;
    --code-content: #171c1e;
    --error: #d2322d;
    --error-content: #ffffff;
    }
    * {
    -webkit-box-sizing: border-box;
    -moz-box-sizing: border-box;
    box-sizing: border-box;
    }

    body, html {
    font-size: 62.5%;
    }
    body {
    background-color: var(--neutral);
    color: var(--neutral-content);
    font-family: 'Open Sans', sans-serif;
    margin: 0;
    }
    code {
    font-family: Consolas, "Liberation Mono", Menlo, Courier, monospace;
    font-size: 85%;
    }
    h1, h2, h3, h4, h5, h6 {
    font-weight: normal;
    }
    a {
    color: var(--primary);
    text-decoration: none;
    }
    #header {
    background: var(--primary);
    color: var(--primary-content);
    height: 60px;
    padding: 0;
    }
    #header .logo {
    float: left;
    margin: 10px 12px 7px 20px;
    width: 38px;
    height: 38px;
    }
    #header .title {
    display: inline-block;
    float: left;
    height: 60px;
    font-size: 2.4rem;
    letter-spacing: normal;
    line-height: 60px;
    margin: 0;
    }

    .information, #offenses {
    width: 100%;
    padding: 20px;
    color: var(--neutral-content);
    }
    #offenses {
    padding: 0 20px;
    }

    .information .infobox {
    border-left: 3px solid;
    background-color: var(--surface);
    padding: 15px;
    border-color: var(--primary);
    font-size: 1.4rem;
    }
    .information .infobox .total {
    font-weight: bold;
    }
    .information .infobox .info-title {
    font-size: 1.8rem;
    line-height: 2.2rem;
    margin: 0 0 0.5em;
    }
    .information .offenses-list li {
    line-height: 2.6rem;
    }
    .information .offenses-list {
    padding-left: 20px;
    margin-bottom: 0;
    }

    #offenses .offense-box {
    margin-bottom: 20px;
    background-color: var(--surface);
    }
    .fixed .box-title {
    position: fixed;
    top: 0;
    z-index: 10;
    width: 100%;
    }
    .box-title-placeholder {
    display: none;
    }
    .fixed .box-title-placeholder {
    display: block;
    }
    #offenses .offense-box .box-title h3, #offenses .offense-box .box-title-placeholder h3 {
    color: var(--neutral-content);
    background-color: var(--surface-subtle);
    font-size: 2rem;
    line-height: 2rem;
    display: block;
    padding: 15px;
    margin: 0;
    }
    #offenses .offense-box .offense-reports  {
    padding: 0 15px;
    }
    #offenses .offense-box .offense-reports .report {
    border-bottom: 1px solid var(--border);
    padding: 15px 0px;
    position: relative;
    font-size: 1.3rem;
    }
    #offenses .offense-box .offense-reports .report .meta {
    line-height: 2.0;
    }
    #offenses .offense-box .offense-reports .report:last-child {
    border-bottom: none;
    }
    #offenses .offense-box .offense-reports .report pre code {
    display: block;
    background: var(--code-background);
    color: var(--code-content);
    padding: 10px 15px;
    line-height: 1.6rem;
    }
    #offenses .offense-box .offense-reports .report .location {
    font-weight: bold;
    }
    .location-list {
    color: var(--muted);
    margin: 0 0 15px;
    list-style: none;
    padding-left: 0;
    }
    .location-list li {
    margin: 3px 0;
    }
    .location-list summary {
    cursor: pointer;
    font-weight: bold;
    }
    .location-code-list {
    margin: 8px 0 12px;
    }
    .location-code-list .location-line {
    color: var(--muted);
    display: block;
    font-size: 1.2rem;
    margin-top: 8px;
    }
    .location-toggle {
    background: var(--primary);
    border: 0;
    border-radius: 2px;
    color: var(--primary-content);
    cursor: pointer;
    font: inherit;
    margin: 10px 0 8px;
    padding: 6px 10px;
    }
    #offenses .offense-box .offense-reports .report .message code {
    padding: 0.3em;
    background-color: rgba(0,0,0,0.07);
    }
    .severity {
    text-transform: capitalize;
    font-weight: bold;
    padding: 2px 4px;
    border-radius: 2px;
    }
    .highlight {
    padding: 2px;
    border-radius: 2px;
    font-weight: bold;
    }
    .severity.refactor,
    .severity.convention {
    color: var(--accent-content);
    background-color: var(--accent);
    }
    .highlight.refactor,
    .highlight.convention {
    color: var(--accent-content);
    background-color: var(--accent);
    border: 1px solid var(--accent);
    }
    .severity.warning {
    color: var(--secondary-content);
    background-color: var(--secondary);
    }
    .highlight.warning {
    color: var(--secondary-content);
    background-color: var(--secondary-pale);
    border: 1px solid var(--secondary);
    }
    .severity.error,
    .severity.fatal {
    color: var(--error-content);
    background-color: var(--error);
    }
    .highlight.error,
    .highlight.fatal {
    color: var(--error-content);
    background-color: var(--error);
    border: 1px solid var(--error);
    }
    footer {
    margin-bottom: 20px;
    margin-right: 20px;
    font-size: 1.3rem;
    color: var(--muted);
    text-align: right;
    }
    .extra-code {
      color: var(--secondary);
    }
    hr {
      border: none;
      border-top: 3px solid var(--border);
      margin: 20px 0;
    }
    #offenses .offense-box.department {
    background-color: var(--surface-subtle);
    }
    #offenses .offense-box.department .box-title h3,
    #offenses .offense-box.department .box-title-placeholder h3 {
    background-color: var(--surface-subtle);
    color: var(--neutral-content);
    font-weight: bold;
    }
    #offenses .offense-box.department .offense-reports .report {
      padding: 0 0 5px 0;
    }
    </style>

    <script>
    (function() {
      // floating headers. requires classList support.
      if (!('classList' in document.createElement("_"))) return;

      var loaded = false,
        boxes,
        boxPositions;

      window.onload = function() {
        var scrollY = window.scrollY;
        boxes = document.querySelectorAll('.offense-box');
        boxPositions = [];
        for (var i = 0; i < boxes.length; i++)
          // need to add scrollY because the page might be somewhere other than the top when loaded.
          boxPositions[i] = boxes[i].getBoundingClientRect().top + scrollY;
        var locationToggles = document.querySelectorAll('.location-toggle');
        for (var j = 0; j < locationToggles.length; j++) {
          (function(toggle) {
            var details = toggle.parentNode.querySelectorAll('.location-list details');
            var updateToggle = function() {
              var allOpen = details.length > 0;
              for (var k = 0; k < details.length; k++) {
                if (!details[k].open) {
                  allOpen = false;
                  break;
                }
              }
              toggle.setAttribute('aria-expanded', allOpen ? 'true' : 'false');
              toggle.textContent = allOpen ? 'Collapse all code' : 'Expand all code';
            };
            toggle.addEventListener('click', function() {
              var shouldOpen = false;
              for (var k = 0; k < details.length; k++) {
                if (!details[k].open) {
                  shouldOpen = true;
                  break;
                }
              }
              for (var k = 0; k < details.length; k++) {
                details[k].open = shouldOpen;
              }
              updateToggle();
            });
            for (var k = 0; k < details.length; k++) {
              details[k].addEventListener('toggle', updateToggle);
            }
          })(locationToggles[j]);
        }
        loaded = true;
      };

      window.onscroll = function() {
        if (!loaded) return;
        var i,
          idx,
          scrollY = window.scrollY;
        for (i = 0; i < boxPositions.length; i++) {
          if (scrollY <= boxPositions[i] - 1) {
            idx = i;
            break;
          }
        }
        if (typeof idx == 'undefined') idx = boxes.length;
        if (idx > 0)
          boxes[idx - 1].classList.add('fixed');
        for (i = 0; i < boxes.length; i++) {
          if (i < idx) continue;
          boxes[i].classList.remove('fixed');
        }
      };
    })();
    </script>
  </head>
  <body>
    <div id="header">
      <img class="logo" src="data:image/png;base64,<%= base64_encoded_logo_image %>" alt="">
      <h1 class="title">SketchUp Extension RuboCop Inspection Report</h1>
    </div>
    <div class="information">
      <div class="infobox">
        <div class="total">
          <%= pluralize(files.count, 'file') %> inspected: <%= severity_summary %>
        </div>
        <ul class="offenses-list">
          <% categories.each do |category, groups| %>
            <li>
              <a href="#<%= cop_anchor(category) %>">
                <%= category %> - <%= category_severity_counts(category) %>,
                <%= pluralize(category_location_count(category), 'location') %>
              </a>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
    <div id="offenses">
      <% categories.each do |category, groups| %>
      <% if new_department?(category) %>
        <hr>
        <div class="offense-box department">
          <div class="box-title">
            <h3>
              <%= department(category) %> -
              <%= department_severity_counts(category) %>,
              <%= pluralize(department_location_count(category), 'location') %>
            </h3>
          </div>
          <div class="offense-reports">
            <div class="report">
              <span class="message">
                <%= department_description(category) %>
              </span>
            </div>
          </div>
        </div>
      <% end %>
      <div class="offense-box" id="<%= cop_anchor(category) %>">
        <div class="box-title-placeholder"><h3>&nbsp;</h3></div>
        <div class="box-title"><h3><%= category %> - <%= category_severity_counts(category) %>, <%= pluralize(category_location_count(category), 'location') %></h3></div>
        <div class="offense-reports">
          <% groups.each do |reports| %>
          <% report = reports.first %>
          <% offense = report.offense %>
          <div class="report">
            <div class="meta">
              <span class="severity <%= offense.severity %>"><%= offense.severity %>:</span>
              <span class="location"><%= pluralize(reports.count, 'location') %></span> –
              <span class="message"><%= decorated_message(offense) %></span>
            </div>
            <% if reports.count > 1 %>
            <button class="location-toggle" type="button" aria-expanded="false">Expand all code</button>
            <% end %>
            <ul class="location-list">
              <% locations_for(reports).each do |location| %>
              <li>
                <details<%= reports.count == 1 ? ' open' : '' %>>
                  <summary><%= relative_path(location.path) %>: <%= location.lines.join(', ') %></summary>
                  <div class="location-code-list">
                    <% location.reports.each do |location_report| %>
                    <% location_offense = location_report.offense %>
                    <% unless location_offense.location.source_line.strip.empty? %>
                    <span class="location-line">Line <%= location_offense.location.line %></span>
                    <pre><code><%= highlighted_source_line(location_offense) %></code></pre>
                    <% end %>
                    <% end %>
                  </div>
                </details>
              </li>
              <% end %>
            </ul>
          </div>
          <% end %>
        </div>
      </div>
      <% end %>
    </div>
    <footer>
      Generated by <a href="https://github.com/rubocop-hq/rubocop">RuboCop</a>
      <span class="version"><%= RuboCop::Version::STRING %></span> -
      <a href="https://github.com/SketchUp/rubocop-sketchup">RuboCop SketchUp</a>
      <span class="version"><%= RuboCop::SketchUp::VERSION %></span>
    </footer>
  </body>
</html>
